export MEALIE_URL="https://food.domain.tld"
export MEALIE_TOKEN="mealieApiToken"
# stdio is the default. HTTP defaults to OIDC and requires the settings below.
# export MCP_TRANSPORT="http"
# export MCP_HTTP_ADDR=":8080"
# For local unauthenticated HTTP development only:
# export MCP_AUTH_MODE="none"
# Keycloak realm issuer, including /realms/<realm>:
# export OIDC_ISSUER_URL="https://sso.domain.tld/realms/homelab"
# Client ID expected in the access-token audience claim:
# export OIDC_AUDIENCE="homelab-mcp"
# Optional space-separated scopes, for example: "mcp.read mcp.write"
# export OIDC_REQUIRED_SCOPES=""
# The externally reachable MCP resource and its RFC 9728 metadata URL:
# export MCP_PUBLIC_URL="https://mcp.domain.tld/mcp"
# export MCP_RESOURCE_METADATA_URL="https://mcp.domain.tld/.well-known/oauth-protected-resource"
